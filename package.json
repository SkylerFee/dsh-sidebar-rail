{
  "name": "dsh-sidebar-rail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex-style left navigation rail for DeepSeek Harness: persistent icon rail with hover flyouts, workspace sections and pinned projects.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
